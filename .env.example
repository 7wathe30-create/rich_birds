# Node.js >=22.13 is required for the built-in SQLite database.
# Set APP_ORIGIN to the exact public origin in deployment; do not use forwarded Host headers.
APP_ORIGIN=http://localhost:3000
# Optional additional exact trusted origins, for example the assigned Preview URL.
# APP_ALLOWED_ORIGINS=https://your-preview.example
DATABASE_PATH=data/rich-birds.sqlite
CHAIN_NETWORK=testnet
# Server-only override; never returned to the browser. Wallets use the official public RPC.
# CHAIN_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Set only after an audited ERC-721 land contract is deployed to the selected network.
# LAND_CONTRACT_ADDRESS=
# Never enable purchasing until audited contracts and approved payment configuration exist.
